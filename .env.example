# Copy to .env and use Node.js 24: node --env-file=.env server/index.mjs
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
# json_schema, json, or text. Select a mode supported by your endpoint/model.
LLM_OUTPUT_MODE=json_schema
# Full search URL of a hosted or self-hosted Nominatim-compatible geocoder.
# No geocoder is called until you configure this and submit a real-place request.
GEOCODER_URL=
GEOCODER_USER_AGENT=DioramaCabinet/1.0
PORT=8080
# false disables LLM requests at the backend; manual tools remain available.
LLM_ENABLED=true
